{
  "name": "steam-revenue-wishlist-estimator",
  "version": "1.0.0",
  "description": "Chrome extension that estimates Steam game sales, revenue and wishlists on any store page, as ranges with cited coefficients.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/q-sn/steam-revenue-wishlist-estimator.git"
  },
  "homepage": "https://chromewebstore.google.com/detail/kmolckbdnoohadbcjgdfdlchgacdbjij",
  "scripts": {
    "zip": "node tools/pack.mjs",
    "calibrate": "node tools/calibrate.mjs",
    "calibrate:live": "node tools/calibrate.mjs --live",
    "smoke": "node tools/smoke.mjs",
    "locales": "node tools/build-locales.mjs",
    "ranks": "node tools/crawl-wishlist-ranks.mjs",
    "anchors": "node tools/harvest-anchors.mjs",
    "condense": "node tools/condense-anchors.mjs",
    "check:ratio": "node tools/calibrate-follower-ratio.mjs",
    "check:model": "node tools/calibrate-wishlist-model.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
